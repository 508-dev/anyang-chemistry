# The game is a static client with no backend and no secrets. The only
# settings are for the local Vite dev server, read from the process
# environment by scripts/dev.sh and apps/web/vite.config.ts (nothing loads
# this file automatically; export the variables in your shell).

# Leave unset to use this worktree's deterministic port (./scripts/worktree-ports.sh env).
WEB_HOST=127.0.0.1
# WEB_PORT=8730

# Optional worktree orchestrator reservations. Leave unset for path-hashed ports.
# WORKTREE_PORT_BLOCK_START=
# WORKTREE_PORT_BLOCK_SIZE=10
# WORKTREE_PRIMARY_PORT=
# WORKTREE_PRIMARY_PORT_TARGET=WEB_PORT
